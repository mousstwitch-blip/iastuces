# Copie ce fichier en ".env" puis renseigne uniquement ce dont tu as besoin.
# Le fichier .env est ignoré par git : tes clés ne quittent jamais ta machine.
# AUCUNE clé n'est obligatoire : sans clé, le studio utilise Claude Code (commande
# `claude`), Pollinations (images) et Edge TTS (voix), tous gratuits.

# Écriture / vérification par l'API Anthropic  -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Service compatible OpenAI (textes et, si images.allow_paid = true, images gpt-image-1)
# -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Jeton Pollinations facultatif (retire le filigrane, files d'attente prioritaires)
# -> https://auth.pollinations.ai
POLLINATIONS_TOKEN=

# Proxy HTTPS éventuel (déjà défini dans les environnements cloud)
# HTTPS_PROXY=
